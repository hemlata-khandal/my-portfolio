  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest --config ./jest.config.js",
    "test:coverage": "jest --config ./jest.config.js --coverage",
    "eject": "react-scripts eject",
    "lint": "eslint './src/**/*.{ts,tsx,js,jsx}'",
    "lint:fix": "eslint --fix './src/**/*.{ts,tsx,js,jsx}'",
    "prettier": "prettier --check './src/**/*.{ts,tsx,js,jsx}'",
    "prettier:fix": "prettier --write './src/**/*.{ts,tsx,js,jsx}'",
    "stylelint": "stylelint './src/**/*.{ts,tsx,js,jsx}'",
    "stylelint:fix": "stylelint --fix './src/**/*.{ts,tsx,js,jsx}'",
    "lint-staged": "lint-staged",
    "postinstall": "husky install"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/styled-components": "^5.1.18",
    "@typescript-eslint/eslint-plugin": "^4.29.2",
    "@typescript-eslint/parser": "^4.29.2",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-cypress": "^2.11.3",
    "eslint-plugin-import": "^2.24.0",
    "eslint-plugin-jest": "^24.4.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "firebase-tools": "^10.1.2",
    "husky": "^7.0.4",
    "jest-html-reporters": "^2.1.6",
    "jest-junit": "^13.0.0",
    "jest-styled-components": "^7.0.8",
    "lint-staged": "^12.1.4",
    "prettier": "^2.5.1",
    "stylelint": "^14.2.0",
    "stylelint-config-recommended": "^6.0.0",
    "stylelint-config-standard": "^24.0.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-processor-styled-components": "^1.10.0",
    "ts-jest": "^27.1.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint . --fix './src/**/*.{ts,tsx,js,jsx}'",
      "prettier --write './src/**/*.{ts,tsx,js,jsx}'",
      "stylelint --fix './src/**/*.{ts,tsx,js,jsx}'"
    ]
  }
}
